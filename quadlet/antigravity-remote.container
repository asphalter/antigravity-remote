[Unit]
Description=Antigravity IDE Remote — Web Desktop (KasmVNC + Openbox)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/antigravity-remote:latest
ContainerName=antigravity-remote

# --- Network: Publish ports to host (8080: IDE, 8081: FileBrowser) ---
PublishPort=8080:8080
PublishPort=8081:8081

# --- Podman-in-Podman (rootless container runtime) ---
AddCapability=SYS_ADMIN
AddCapability=MKNOD
AddDevice=/dev/fuse
SecurityLabelDisable=true

# --- Resource allocation ---
ShmSize=2g
PodmanArgs=--memory=16g --cpus=8

# --- Environment variables (Agent Execution & Review Policies) ---
# TERMINAL_AUTO_EXECUTION:
#   - eager (default): Execute shell commands autonomously without confirmation prompts
#   - off: Require manual confirmation for every terminal command
Environment=TERMINAL_AUTO_EXECUTION=eager

# ARTIFACT_REVIEW_POLICY:
#   - always (default): Require explicit user approval before executing Implementation Plans
#   - turbo: Automatically approve and proceed with Implementation Plans unattended
Environment=ARTIFACT_REVIEW_POLICY=always

# --- Persistent volume for /home/antigravity ---
Volume=antigravity-home.volume:/home/antigravity

# --- Health check for KasmVNC HTTP server ---
HealthCmd=curl -fsSo /dev/null http://localhost:8080/ || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=20s

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=15

[Install]
WantedBy=default.target
