# ==============================================================================
# antigravity-home.volume — Persistent volume definition for /home/antigravity
#
# Place alongside antigravity-remote.container in:
#   Rootless: ~/.config/containers/systemd/
#   Rootful:  /etc/containers/systemd/
# ==============================================================================

[Unit]
Description=Antigravity IDE — Persistent Home Volume

[Volume]
# The Podman volume name matches the file name without extension (antigravity-home)
# Podman automatically creates this volume if it does not already exist
